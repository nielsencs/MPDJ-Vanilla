# Normalize text line endings in the repository.
# This keeps GitHub diffs from showing accidental LF <-> CRLF rewrites.
* text=auto

# Source/text files should stay LF, even when edited on Windows.
*.java text eol=lf
*.kt text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.xml text eol=lf
*.svg text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.mk text eol=lf
Makefile text eol=lf

# Windows command scripts are the exception.
*.bat -text

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.svgz binary
*.apk binary
*.zip binary
